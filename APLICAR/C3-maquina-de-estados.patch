+       decima primeira rodada, pela porta que tinha sobrado. */
+    if (soltando) { try { await soltando; } catch (e) {} }
     if (adiantando) { try { await adiantando; } catch (e) {} }
     if (pipeServe(modelId)) return pipe;
     return await trocarPipe(modelId);
@@ -13382,8 +13445,11 @@ function(t){t.__bidiEngine__=t.prototype.__bidiEngine__=function(t){var r,n,i,a,
        a contagem ao entrar no `catch` é o que diz isso; a bandeira garante que
        o `finally` não desconte duas vezes. */
     let contada = true;
-    const encerrarConta = () => { if (contada) { contada = false; usandoPipe--; } };
+    const encerrarConta = () => {
+      if (contada) { contada = false; usandoPipe--; anotarEstado(); }
+    };
     usandoPipe++;
+    anotarEstado();
     try {
       const r = await pipe(dados, opts);
       relogio.audio += seg; relogio.ms += performance.now() - t0;
