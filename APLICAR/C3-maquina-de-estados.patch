+  let estadoAnterior = null;
+  function anotarEstado(){
+    const agora = estadoAsr();
+    if (agora === estadoAnterior) return agora;
+    marco('asr.estado', { de: estadoAnterior, para: agora });
+    estadoAnterior = agora;
+    return agora;
+  }
+  try { window.__estadoAsr = () => estadoAsr(); } catch (e) {}
+
   async function soltarPipe(){
     const velho = pipe;
     pipe = null; pipeId = null; pipeDev = null;
     if (!velho) return false;
+    let pronto;
+    soltando = new Promise((r) => { pronto = r; });
+    anotarEstado();
+    try {
+      return await soltarDeVerdade(velho);
+    } finally {
+      soltando = null; pronto();
+      anotarEstado();
+    }
+  }
+
+  async function soltarDeVerdade(velho){
     for (let i = 0; usandoPipe > 0 && i < 600; i++) {
       await new Promise(r => setTimeout(r, 100));
     }
@@ -13218,10 +13273,12 @@ function(t){t.__bidiEngine__=t.prototype.__bidiEngine__=function(t){var r,n,i,a,
       return novo;
     })();
