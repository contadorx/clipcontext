+  let soltando = null;
+
+  const ESTADOS_ASR = ['ocioso', 'montando', 'pronto', 'inferindo', 'soltando', 'caido'];
+  function estadoAsr(){
+    if (soltando)          return 'soltando';
+    if (montando)          return 'montando';
+    if (usandoPipe > 0)    return 'inferindo';
+    if (pipe)              return 'pronto';
+    if (ultimoErroModelo)  return 'caido';
+    return 'ocioso';
+  }
+
+  /* A transicao entra na regua so quando MUDA. Marcar a cada consulta encheria
