+  function classificarQueda(msg) {
+    const m = String(msg || '');
+    /* A ORDEM IMPORTA, e ela e por CONSEQUENCIA: memoria primeiro porque e a
+       unica que muda a decisao para PARAR de subir. Uma mensagem que fala de
+       memoria E de sessao e um problema de memoria — a sessao so nao subiu
+       porque nao havia onde. */
