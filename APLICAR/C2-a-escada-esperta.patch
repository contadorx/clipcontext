+    if (ERRO_REDE.test(m))    return 'rede';
+    if (ERRO_FALTA.test(m))   return 'falta';
+    if (ERRO_RUNTIME.test(m)) return 'runtime';
+    if (ERRO_SESSAO.test(m))  return 'sessao';
+    return null;
+  }
