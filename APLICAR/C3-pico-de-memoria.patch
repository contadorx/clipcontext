      contrario, um marco que carregasse um campo `ms` proprio — e o da escada de
      degraus carregava — sobrescrevia o instante com uma DURACAO, e a linha do
      tempo passava a andar para tras. Apanhei disso: o teste da ordem reprovou. */
   function marco(nome, extra){
     try { performance.mark('ws:' + nome); } catch (e) {}
+    amostrarMemoria(nome);
     MEDIDAS.marcos.push(Object.assign({}, extra || {},
                                       { nome, ms: Math.round(performance.now()) }));
   }
@@ -12435,6 +12466,13 @@ function(t){t.__bidiEngine__=t.prototype.__bidiEngine__=function(t){var r,n,i,a,
