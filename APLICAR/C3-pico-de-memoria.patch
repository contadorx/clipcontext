@@ -13349,6 +13387,10 @@ function(t){t.__bidiEngine__=t.prototype.__bidiEngine__=function(t){var r,n,i,a,
     try {
       const r = await pipe(dados, opts);
       relogio.audio += seg; relogio.ms += performance.now() - t0;
+      /* O pico pode acontecer NO MEIO da inferencia, entre dois marcos. Uma
+         amostra por trecho custa nada e cobre a janela em que o modelo esta
+         com o maior numero de tensores vivos. */
+      amostrarMemoria('inferencia');
       /* O PRIMEIRO TEXTO. É a medida que descreve a espera de quem está
          olhando: o resto do vídeo pode levar quarenta minutos, mas o que decide
          se a pessoa fecha a aba é quanto tempo a tela ficou muda. */
@@ -13400,6 +13442,7 @@ function(t){t.__bidiEngine__=t.prototype.__bidiEngine__=function(t){var r,n,i,a,
       try {
         const r = await pipe(dados, opts);         // o MESMO pedido, uma vez só
         relogio.audio += seg; relogio.ms += performance.now() - t1;
+        amostrarMemoria('inferencia');
         return r;
       } finally { encerrarConta(); }
     } finally { encerrarConta(); }
