+  function amostrarMemoria(onde){
+    try {
+      const m = performance.memory;
+      if (!m || !m.usedJSHeapSize) return;
+      memoria.amostras++;
+      memoria.limite = m.jsHeapSizeLimit || memoria.limite;
+      if (m.usedJSHeapSize > memoria.pico) {
+        memoria.pico = m.usedJSHeapSize;
+        memoria.onde = onde || memoria.onde;
+      }
+    } catch (e) {}
+  }
+  const emMB = (b) => b ? Math.round(b / 1048576) : null;
