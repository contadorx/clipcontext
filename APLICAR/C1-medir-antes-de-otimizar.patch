+            'nome': '%dmin' % minutos, 'caminho': caminho, 'minutos': minutos,
+            'segundos': minutos * 60, 'bytes': os.path.getsize(caminho),
+            'sha256': h.hexdigest(),
+        })
+    with open('/tmp/medida-amostras.json', 'w') as f:
+        json.dump(manifesto, f, indent=2)
+    return manifesto
+
