+.antesDepois{width:100%;border-collapse:collapse;margin-top:22px;font-size:15px}
+.antesDepois th{text-align:left;font-weight:620;font-size:13px;letter-spacing:.02em;
+      text-transform:uppercase;color:color-mix(in srgb, var(--ink) 55%, transparent);
+      padding:0 16px 8px 0;border-bottom:1px solid var(--line)}
+.antesDepois td{padding:13px 16px 13px 0;border-bottom:1px solid var(--line);
+      vertical-align:top;width:50%}
+.antesDepois tbody tr:last-child td{border-bottom:0}
+.antesDepois td:last-child{padding-right:0;font-weight:520}
+.antesDepois td:first-child{color:color-mix(in srgb, var(--ink) 68%, transparent)}
+@media (max-width:640px){
+  .antesDepois, .antesDepois tbody, .antesDepois tr, .antesDepois td{display:block;width:auto}
+  .antesDepois thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
+  .antesDepois tr{padding:12px 0;border-bottom:1px solid var(--line)}
+  .antesDepois td{border:0;padding:2px 0}
+  .antesDepois td::before{content:attr(data-rot);display:block;font-size:12px;
+        text-transform:uppercase;letter-spacing:.02em;
+        color:color-mix(in srgb, var(--ink) 45%, transparent)}
+}
