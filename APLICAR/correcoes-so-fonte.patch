+console.log('\n[3] o redirect não volta para dentro do try');
+{
+  /* O `redirect` do Next funciona LANÇANDO um `NEXT_REDIRECT`. Dentro de um
+     `try` com `catch`, ele é apanhado pelo próprio `catch` — e a recusa limpa
