# Bancadas ligadas no deploy.
#
# Com esta linha, /estilo/tela funciona em produção sem precisar mexer em nada
# na Vercel — o `next build` lê este arquivo sozinho.
#
# PARA DESLIGAR quando terminar de testar: troque para 0 (ou apague o arquivo) e
# publique de novo. Enquanto estiver em 1, quem souber o endereço /estilo/tela
# entra sem login. Não há dado real lá dentro — a massa é inventada e nada é
# gravado — mas o desenho do app fica visível para quem tiver o link.
NEXT_PUBLIC_BANCADA=1
