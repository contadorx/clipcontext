# Preencha na Vercel (Production) e localmente em .env.local.
# Esta lista é a fonte única: foi conferida contra todo `process.env` do código.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OBRIGATÓRIA. O portal do cliente, a leitura da configuração de preço e todos
# os crons passam por ela. Sem esta chave o portal não abre para ninguém.
SUPABASE_SERVICE_ROLE_KEY=

# ── Os dois domínios ────────────────────────────────────────────────────────
# Um projeto Vercel serve o site institucional e o produto; o middleware decide
# qual responde pelo hostname. Só o nome do host — sem https://, sem barra.
#
# Se as duas receberem o MESMO valor, a separação é desligada e o app responde
# em tudo, com o site acessível em /site. É proposital: hosts iguais gerariam
# laço de redirecionamento na tela de login, e desligar é mais seguro do que
# travar. Atenção: deixá-las VAZIAS não desliga nada — vazio cai nos padrões
# abaixo, que são diferentes entre si. Para servir tudo num domínio só, escreva
# o mesmo host nas duas.
NEXT_PUBLIC_SITE_HOST=financeirox.com.br
NEXT_PUBLIC_APP_HOST=app.financeirox.com.br

# Base absoluta dos links que saem em e-mail (lembrete de boleto, régua de
# cobrança, digest). Tem PRIORIDADE sobre NEXT_PUBLIC_APP_HOST, então precisa
# apontar para o host do APP — apesar do nome. Apontá-la para o institucional
# manda o pagador para uma página que não existe. Se ficar vazia, o host do app
# é usado, que é o comportamento correto: na dúvida, deixe vazia.
NEXT_PUBLIC_SITE_URL=

# ── Crons e webhooks ────────────────────────────────────────────────────────
# OBRIGATÓRIA. As rotas /api/* ficam fora do middleware (senão o cron da Vercel
# e o webhook do Asaas recebiam redirecionamento para o login). Sem este segredo
# as rotas de cron respondem 401 a todo mundo — inclusive à Vercel. Um GET
# anônimo em /api/cron/expurgo-documentos apagaria documento de todas as contas.
CRON_SECRET=

# OBRIGATÓRIA para receber baixa de pagamento. O webhook confere este token e
# devolve 401 quando ele falta — a notificação do Asaas se perde em silêncio.
ASAAS_WEBHOOK_TOKEN=

# ── Asaas (cobrança da assinatura e dos créditos de IA) ─────────────────────
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_URL=

# ── E-mail transacional (Brevo) ─────────────────────────────────────────────
BREVO_API_KEY=
# OBRIGATÓRIA: o envio lança sem ela e nenhum e-mail sai — nem cobrança, nem
# lembrete de boleto, nem convite.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FinanceiroX

# ── IA (Anthropic) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Opcional: sobrescreve o modelo padrão.
ANTHROPIC_MODEL=

# ── NFS-e ───────────────────────────────────────────────────────────────────
# Chave usada para cifrar a senha do certificado A1 do cliente. Trocá-la torna
# ilegíveis os certificados já guardados.
NFSE_CRYPTO_KEY=

# ── Desenvolvimento ─────────────────────────────────────────────────────────
# Abre o catálogo visual em /estilo sem login. NUNCA ligar em produção.
# NEXT_PUBLIC_BANCADA=1
